import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.util.Scanner;

public class javaprojectparttwo {

    // Parking lot structure parameters
    private static final int LEVELS = 3;
    private static final int SLOTS_PER_LEVEL = 5;

    // Arrays to store parking slot details
    private static String[][] vehicleNumber = new String[LEVELS][SLOTS_PER_LEVEL];
    private static String[][] vehicleType = new String[LEVELS][SLOTS_PER_LEVEL];
    private static long[][] entryTime = new long[LEVELS][SLOTS_PER_LEVEL]; // Entry timestamp in milliseconds

    private static final String DATA_FILE = "parking_records.txt";

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        loadFromFile(); // Load existing records using File Handling

        int choice;
        do {
            System.out.println("\n========================================");
            System.out.println("   MULTI-LEVEL PARKING LOT MANAGER     ");
            System.out.println("========================================");
            System.out.println("1. Park Vehicle (Entry & Slot Allocation)");
            System.out.println("2. Remove Vehicle (Exit & Fee Calculation)");
            System.out.println("3. View Real-Time Slot Availability");
            System.out.println("4. Exit & Save Records");
            System.out.print("Enter your choice: ");

            while (!scanner.hasNextInt()) {
                System.out.print("Invalid input. Enter a number (1-4): ");
                scanner.next();
            }
            choice = scanner.nextInt();
            scanner.nextLine(); // consume newline

            // Conditional statements to control program flow
            switch (choice) {
                case 1:
                    parkVehicle(scanner);
                    break;
                case 2:
                    removeVehicle(scanner);
                    break;
                case 3:
                    viewParkingStatus();
                    break;
                case 4:
                    saveToFile();
                    System.out.println("Parking records saved successfully. Exiting program...");
                    break;
                default:
                    System.out.println("Invalid choice! Please choose between 1 and 4.");
            }
        } while (choice != 4);

        scanner.close();
    }

    // Method to allocate space and track vehicle entry
    public static void parkVehicle(Scanner scanner) {
        System.out.print("Enter License Plate Number: ");
        String plate = scanner.nextLine();
        System.out.print("Enter Vehicle Type (Bike / Car / SUV): ");
        String type = scanner.nextLine();

        boolean parked = false;
        // Nested loops to iterate through levels and slots
        for (int i = 0; i < LEVELS; i++) {
            for (int j = 0; j < SLOTS_PER_LEVEL; j++) {
                if (vehicleNumber[i][j] == null) {
                    vehicleNumber[i][j] = plate;
                    vehicleType[i][j] = type;
                    entryTime[i][j] = System.currentTimeMillis(); // Record entry timestamp
                    parked = true;
                    System.out.println("\n[Success] Vehicle parked at Level " + (i + 1) + ", Slot " + (j + 1));
                    saveToFile();
                    return;
                }
            }
        }
        if (!parked) {
            System.out.println("\n[Notice] Sorry, the parking lot is completely full!");
        }
    }

    // Method to handle exit, automated fee calculation, and freeing up slots
    public static void removeVehicle(Scanner scanner) {
        System.out.print("Enter License Plate Number to Exit: ");
        String plate = scanner.nextLine();

        boolean found = false;
        for (int i = 0; i < LEVELS; i++) {
            for (int j = 0; j < SLOTS_PER_LEVEL; j++) {
                if (vehicleNumber[i][j] != null &&
                    vehicleNumber[i][j].equalsIgnoreCase(plate)) {
                    String type = vehicleType[i][j];
                    long entry = entryTime[i][j];
                    long exit = System.currentTimeMillis();

                    // Free up slot
                    vehicleNumber[i][j] = null;
                    vehicleType[i][j] = null;
                    entryTime[i][j] = 0;
                    found = true;

                    // Automated duration and fee calculation
                    long durationMillis = exit - entry;
                    double durationMinutes = durationMillis / (1000.0 * 60.0);
                    double fee = calculateFee(type, durationMinutes);

                    System.out.println("\n[Success] Vehicle removed from Level " + (i + 1) + ", Slot " + (j + 1));
                    System.out.println("Vehicle Type: " + type);
                    System.out.println("Total Parking Duration: " + String.format("%.2f", durationMinutes) + " minutes");
                    System.out.println("Automated Parking Fee: Rs. " + String.format("%.2f", fee));
                    saveToFile();
                    return;
                }
            }
        }
        if (!found) {
            System.out.println("\n[Error] Vehicle with license plate " + plate + " not found.");
        }
    }

    // Helper method for automated fee calculation based on duration and size
    public static double calculateFee(String type, double minutes) {
        double ratePerMinute = 1.0;
        if (type.equalsIgnoreCase("Bike")) {
            ratePerMinute = 0.5;
        } else if (type.equalsIgnoreCase("Car")) {
            ratePerMinute = 1.0;
        } else if (type.equalsIgnoreCase("SUV")) {
            ratePerMinute = 1.5;
        }
        double fee = minutes * ratePerMinute;
        return Math.max(fee, 20.0); // Minimum base fee of Rs. 20
    }

    // Method to view real-time slot availability across all levels
    public static void viewParkingStatus() {
        System.out.println("\n--- Real-Time Parking Slot Status ---");
        for (int i = 0; i < LEVELS; i++) {
            System.out.println("Level " + (i + 1) + ":");
            for (int j = 0; j < SLOTS_PER_LEVEL; j++) {
                if (vehicleNumber[i][j] == null) {
                    System.out.println("  Slot " + (j + 1) + " -> [ Available ]");
                } else {
                    System.out.println("  Slot " + (j + 1) + " -> [ Occupied | Plate: " + vehicleNumber[i][j] + " | Type: " + vehicleType[i][j] + " ]");
                }
            }
        }
    }

    // File Handling: Save current records to a text file
    public static void saveToFile() {
        try (PrintWriter writer = new PrintWriter(new FileWriter(DATA_FILE))) {
            for (int i = 0; i < LEVELS; i++) {
                for (int j = 0; j < SLOTS_PER_LEVEL; j++) {
                    if (vehicleNumber[i][j] != null) {
                        writer.println(i + "," + j + "," + vehicleNumber[i][j] + "," + vehicleType[i][j] + "," + entryTime[i][j]);
                    }
                }
            }
        } catch (IOException e) {
            System.out.println("[Error] Could not save records to file.");
        }
    }

    // File Handling: Load previous records upon startup
    public static void loadFromFile() {
        File file = new File(DATA_FILE);
        if (!file.exists()) return;

        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
            String line;
            while ((line = reader.readLine()) != null) {
                String[] parts = line.split(",");
                if (parts.length == 5) {
                    int level = Integer.parseInt(parts[0]);
                    int slot = Integer.parseInt(parts[1]);
                    vehicleNumber[level][slot] = parts[2];
                    vehicleType[level][slot] = parts[3];
                    entryTime[level][slot] = Long.parseLong(parts[4]);
                }
            }
        } catch (IOException e) {
            System.out.println("[Error] Could not load
            records from file.");
        }
    }
}
